<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Day-one: AOT on publish only; build uses IsAotCompatible from Directory.Build.props -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <!-- LibraryImport generator emits unsafe marshalling helpers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
