<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinMint.Wizard.ViewModels"
             x:Class="WinMint.Wizard.Views.PreviewStepView"
             x:DataType="vm:WizardShellViewModel">
  <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Classes="hero-title" Text="Preview the build" />
    <TextBlock Classes="hero-sub"
               Text="Generate a Profile and inspect the plan. Nothing is written to an ISO until you run the Cli recipe." />

    <Border Classes="iso-stage">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Text="Source" Opacity="0.55" />
          <TextBlock Grid.Column="1" Text="{Binding SourceIsoPath}" TextWrapping="Wrap" TextAlignment="Right" />
          <TextBlock Grid.Row="1" Text="Lane" Opacity="0.55" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImageQuality}" TextAlignment="Right" />
          <TextBlock Grid.Row="2" Text="Posture" Opacity="0.55" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preset}" TextAlignment="Right" />
          <TextBlock Grid.Row="3" Text="Plan" Opacity="0.55" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlanSummary}" TextWrapping="Wrap" TextAlignment="Right" />
        </Grid>
        <Button Classes="ghost"
                Content="Re-run Plan"
                HorizontalAlignment="Left"
                Command="{Binding ReplanCommand}" />
        <TextBox Text="{Binding PreviewJson}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 MinHeight="200"
                 FontFamily="Cascadia Mono, Consolas, monospace"
                 PlaceholderText="Profile JSON" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Status}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemErrorTextColor}"
               IsVisible="{Binding StatusIsError}" />
  </StackPanel>
</UserControl>
