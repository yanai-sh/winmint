<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinMint.Wizard.ViewModels"
             x:Class="WinMint.Wizard.Views.ConfigureStepView"
             x:DataType="vm:WizardShellViewModel">
  <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Classes="hero-title" Text="Configure the build" />
    <TextBlock Classes="hero-sub"
               Text="Adjust what stays on the image and what FirstLogon installs. Defaults already reflect the WinMint posture." />

    <!-- v1 wizard-columns: curated panels only -->
    <UniformGrid Columns="2" Rows="3">
      <Border Classes="panel-card" Margin="0,0,8,8">
        <StackPanel>
          <TextBlock Classes="panel-label" Text="POSTURE" />
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="chip" Content="Recommended" IsChecked="{Binding IsRecommendedPreset}" Command="{Binding SelectRecommendedPresetCommand}" />
            <ToggleButton Classes="chip" Content="Acceptance" IsChecked="{Binding IsAcceptancePreset}" Command="{Binding SelectAcceptancePresetCommand}" />
            <ToggleButton Classes="chip" Content="Empty" IsChecked="{Binding IsEmptyPreset}" Command="{Binding SelectEmptyPresetCommand}" />
          </StackPanel>
          <Button Classes="chip" Content="Use this PC region" Command="{Binding UseHostDmaCommand}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="panel-card" Margin="8,0,0,8">
        <StackPanel>
          <TextBlock Classes="panel-label" Text="KEEP" />
          <StackPanel Orientation="Horizontal">
            <ToggleButton Classes="chip" Content="Xbox &amp; gaming" IsChecked="{Binding KeepGaming}" />
            <ToggleButton Classes="chip" Content="Copilot" IsChecked="{Binding KeepCopilot}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel-card" Margin="0,0,8,8">
        <StackPanel>
          <TextBlock Classes="panel-label" Text="BROWSERS" />
          <ItemsControl ItemsSource="{Binding BrowserChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChipItem">
                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel-card" Margin="8,0,0,8">
        <StackPanel>
          <TextBlock Classes="panel-label" Text="EDITORS" />
          <ItemsControl ItemsSource="{Binding EditorChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChipItem">
                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel-card" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Classes="panel-label" Text="SHELL" />
          <ItemsControl ItemsSource="{Binding ShellChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChipItem">
                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel-card" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Classes="panel-label" Text="WSL" />
          <ItemsControl ItemsSource="{Binding WslChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChipItem">
                <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </UniformGrid>
  </StackPanel>
</UserControl>
