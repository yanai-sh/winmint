<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinMint.Wizard.ViewModels"
             x:Class="WinMint.Wizard.Views.ReviewStepView"
             x:DataType="vm:IReviewStageViewModel">
  <StackPanel Spacing="16" MaxWidth="640">
    <TextBlock Classes="hero-title" Text="Review" />
    <TextBlock Classes="hero-sub" Text="{Binding Summary.QuietSummaryText}" />

    <Border Classes="panel-card" HorizontalAlignment="Stretch">
      <StackPanel>
        <Grid Classes="receipt-row" ColumnDefinitions="140,*" Margin="0,0,0,12">
          <TextBlock Classes="receipt-k" Text="Source" />
          <TextBlock Classes="receipt-v" Grid.Column="1" Text="{Binding Summary.SourceIsoPath}" />
        </Grid>
        <Grid Classes="receipt-row" ColumnDefinitions="140,*" Margin="0,0,0,12">
          <TextBlock Classes="receipt-k" Text="Edition" />
          <TextBlock Classes="receipt-v" Grid.Column="1" Text="{Binding Summary.EditionName}" />
        </Grid>
        <Grid Classes="receipt-row" ColumnDefinitions="140,*" Margin="0,0,0,12">
          <TextBlock Classes="receipt-k" Text="Account" />
          <TextBlock Classes="receipt-v" Grid.Column="1" Text="{Binding Summary.AccountName}" />
        </Grid>
        <Grid Classes="receipt-row" ColumnDefinitions="140,*" Margin="0,0,0,12">
          <TextBlock Classes="receipt-k" Text="Wi-Fi" />
          <TextBlock Classes="receipt-v" Grid.Column="1" Text="{Binding Summary.WifiLabel}" />
        </Grid>
        <Grid Classes="receipt-row" ColumnDefinitions="140,*" Margin="0,0,0,12">
          <TextBlock Classes="receipt-k" Text="Region" />
          <TextBlock Classes="receipt-v" Grid.Column="1" Text="{Binding Summary.RegionLabel}" />
        </Grid>
        <Grid Classes="receipt-row" ColumnDefinitions="140,*">
          <TextBlock Classes="receipt-k" Text="Output" />
          <TextBlock Classes="receipt-v" Grid.Column="1" Text="{Binding Summary.OutputIsoPath}" />
        </Grid>

        <TextBlock Text="{Binding Summary.PickStripText}"
                   Margin="0,14,0,0"
                   FontWeight="Medium"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Summary.PickStripText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Classes="quiet-box">
          <TextBlock Text="{Binding Summary.QuietBlockText}" TextWrapping="Wrap" FontSize="13" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Classes="ghost"
                  Content="Save Profile"
                  HorizontalAlignment="Left"
                  Command="{Binding SaveProfileCommand}"
                  IsEnabled="{Binding !Build.IsBusy}" />
          <Button Classes="ghost"
                  Content="Export Station pack"
                  HorizontalAlignment="Left"
                  Command="{Binding ExportStationPackCommand}"
                  IsEnabled="{Binding !Build.IsBusy}"
                  AutomationProperties.Name="Export Station pack" />
        </StackPanel>
        <TextBlock Text="{Binding Build.SaveStatus}"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <ProgressBar IsIndeterminate="True"
                     Height="4"
                     IsVisible="{Binding Build.IsBusy}"
                     Margin="0,8,0,0" />
        <TextBlock Text="{Binding Build.BuildWaitHint}"
                   TextWrapping="Wrap"
                   Opacity="0.65"
                   FontSize="12"
                   IsVisible="{Binding Build.IsBusy}" />
        <TextBlock Text="{Binding Build.BuildStatus}" TextWrapping="Wrap" Opacity="0.85" />
        <ScrollViewer MaxHeight="160"
                      IsVisible="{Binding Build.StatusTail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Margin="0,4,0,0">
          <TextBlock Text="{Binding Build.StatusTail}"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="12"
                     Opacity="0.8" />
        </ScrollViewer>

        <Border Classes="flash"
                IsVisible="{Binding Build.FlashGuidanceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="6">
            <TextBlock Classes="panel-label" Text="FLASH" Margin="0" />
            <TextBlock Text="{Binding Build.FlashGuidanceText}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontFamily="Cascadia Mono, Consolas, monospace" />
          </StackPanel>
        </Border>

        <Expander Header="What's included" IsExpanded="False" Margin="0,12,0,0"
                  IsVisible="{Binding Summary.WhatsIncludedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding Summary.WhatsIncludedText}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" />
        </Expander>

        <Expander Header="Show full plan" IsExpanded="False" Margin="0,4,0,0"
                  IsVisible="{Binding Summary.FullPlanText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary.PlanSummary}" TextWrapping="Wrap" Opacity="0.75" />
            <Button Classes="link" Content="Re-run Plan" Command="{Binding ReplanCommand}" />
            <TextBlock Text="{Binding Summary.FullPlanText}"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="12" />
          </StackPanel>
        </Expander>

        <Expander Header="Plan JSON" IsExpanded="False" Margin="0,4,0,0">
          <TextBox Text="{Binding Summary.PreviewJson}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   MinHeight="160"
                   Margin="0,8,0,0"
                   FontFamily="Cascadia Mono, Consolas, monospace"
                   Watermark="Profile JSON" />
        </Expander>

        <Expander Header="CLI equivalent" IsExpanded="False" Margin="0,4,0,0">
          <TextBox Text="{Binding Summary.BuildRecipe}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="64"
                   Margin="0,8,0,0"
                   FontFamily="Cascadia Mono, Consolas, monospace" />
        </Expander>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Status.Message}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemErrorTextColor}"
               IsVisible="{Binding Status.IsError}" />
  </StackPanel>
</UserControl>
