<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinMint.Wizard.ViewModels"
             xmlns:orchestrator="using:WinMint.Orchestrator"
             x:Class="WinMint.Wizard.Views.SourceStepView"
             x:DataType="vm:ISourceStageViewModel"
             DragDrop.AllowDrop="True">
  <StackPanel Spacing="18" MaxWidth="640">
    <TextBlock Classes="hero-title" Text="Source" />
    <TextBlock Classes="hero-sub"
               Text="Official Windows ISO on this PC. WinMint does not download media." />

    <Button x:Name="IsoPick"
            Classes="iso-pick"
            Command="{Binding BrowseIsoCommand}"
            IsVisible="{Binding SourceIsoPath, Converter={x:Static StringConverters.IsNullOrEmpty}}">
      <StackPanel Spacing="6">
        <TextBlock Text="Drop or choose Windows ISO" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Official media on this PC — not a download"
                   Opacity="0.65"
                   FontSize="13"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Button>

    <Border x:Name="IsoStage"
            Classes="iso-stage"
            IsVisible="{Binding SourceIsoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Ready" FontSize="12" FontWeight="SemiBold" Foreground="#0F7B0F" />
          <TextBlock Text="Source selected" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SourceIsoPath}"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="12"
                     Opacity="0.55"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="ghost"
                Content="Change"
                VerticalAlignment="Center"
                Command="{Binding BrowseIsoCommand}" />
      </Grid>
    </Border>

    <TextBlock Text="Reading editions from ISO…"
               Opacity="0.55"
               IsVisible="{Binding IsWimProbeBusy}" />

    <Border Classes="panel-card" HorizontalAlignment="Stretch"
            IsVisible="{Binding IsWimPickerVisible}">
      <StackPanel Spacing="10">
        <TextBlock Classes="panel-label" Text="Source edition" />
        <ComboBox ItemsSource="{Binding WimIndexes}"
                  SelectedItem="{Binding SelectedWimIndex}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="orchestrator:WimIndexInfo">
              <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Index Apply exports this edition (single-image media after build)."
                   Opacity="0.55"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Button Classes="primary"
            Content="Use WinMint defaults → Review"
            HorizontalAlignment="Left"
            Command="{Binding $parent[Window].((vm:WizardViewModel)DataContext).UseWinMintDefaultsCommand}"
            IsVisible="{Binding SourceIsoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TextBlock Text="{Binding Status.Message}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemErrorTextColor}"
               IsVisible="{Binding Status.IsError}" />
  </StackPanel>
</UserControl>
