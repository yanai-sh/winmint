<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinMint.Wizard.ViewModels"
             x:Class="WinMint.Wizard.Views.SoftwareStepView"
             x:DataType="vm:ISoftwareStageViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ChipTile" x:DataType="vm:ChipItem">
      <ToggleButton Classes="tile"
                    IsChecked="{Binding IsSelected}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip.Tip="{Binding ToolTip}">
        <StackPanel>
          <TextBlock Classes="tile-glyph" Text="{Binding Glyph}" />
          <TextBlock Classes="tile-label" Text="{Binding Label}" />
        </StackPanel>
      </ToggleButton>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="16" MaxWidth="720">
    <TextBlock Classes="hero-title" Text="Software" />
    <TextBlock Classes="hero-sub"
               Text="Editors, browsers, shell, and WSL — or continue with recommended defaults." />

    <Button Classes="link"
            Content="Use defaults → Review"
            Command="{Binding UseDefaultsCommand}" />

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="Editors" />
      <ItemsControl ItemsSource="{Binding Chips.Editors}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="Browsers" />
      <ItemsControl ItemsSource="{Binding Chips.Browsers}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="Shell" />
      <ItemsControl ItemsSource="{Binding Chips.Shells}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="WSL" />
      <ItemsControl ItemsSource="{Binding Chips.Wsl}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <Expander Header="Advanced packages (optional)" IsExpanded="False">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Classes="panel-label" Text="Cleanup preset" />
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="chip" Content="Recommended" IsChecked="{Binding Presets.IsRecommended}"
                        Command="{Binding Presets.SelectCommand}" CommandParameter="recommended" />
          <ToggleButton Classes="chip" Content="Acceptance" IsChecked="{Binding Presets.IsAcceptance}"
                        Command="{Binding Presets.SelectCommand}" CommandParameter="acceptance" />
          <ToggleButton Classes="chip" Content="Empty" IsChecked="{Binding Presets.IsEmpty}"
                        Command="{Binding Presets.SelectCommand}" CommandParameter="empty" />
        </StackPanel>
        <TextBlock Classes="hero-sub"
                   Text="Acceptance / Empty override chip selections. MinGit and Nilesoft Shell are always installed." />
        <TextBlock Classes="panel-label" Text="Winget install IDs" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                 Watermark="Anysphere.Cursor&#x0A;Zen-Team.Zen-Browser"
                 Text="{Binding Advanced.Winget}" />
        <TextBlock Classes="panel-label" Text="Scoop IDs" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                 Watermark="curl&#x0A;komorebi"
                 Text="{Binding Advanced.Scoop}" />
        <TextBlock Classes="panel-label" Text="WSL tokens" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                 Watermark="FedoraLinux&#x0A;NixOS-WSL"
                 Text="{Binding Advanced.Wsl}" />
      </StackPanel>
    </Expander>

    <TextBlock Text="{Binding Status.Message}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemErrorTextColor}"
               IsVisible="{Binding Status.IsError}" />
  </StackPanel>
</UserControl>
