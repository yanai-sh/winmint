<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WinMint.Wizard.ViewModels"
             x:Class="WinMint.Wizard.Views.SoftwareStepView"
             x:DataType="vm:ISoftwareStageViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ChipTile" x:DataType="vm:ChipItem">
      <ToggleButton Classes="tile"
                    IsChecked="{Binding IsSelected}"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip.Tip="{Binding ToolTip}">
        <StackPanel>
          <TextBlock Classes="tile-glyph" Text="{Binding Glyph}" />
          <TextBlock Classes="tile-label" Text="{Binding Label}" />
        </StackPanel>
      </ToggleButton>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="16" MaxWidth="720">
    <TextBlock Classes="hero-title" Text="Software" />
    <TextBlock Classes="hero-sub"
               Text="Pick a Station outcome to seed chips and cleanup, then refine as needed." />

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="Station outcome" />
      <StackPanel Orientation="Horizontal">
        <ToggleButton Classes="chip" Content="Comfort" IsChecked="{Binding Outcomes.IsComfort}"
                      Command="{Binding Outcomes.SelectCommand}" CommandParameter="comfort"
                      AutomationProperties.Name="Comfort Station outcome" />
        <ToggleButton Classes="chip" Content="Minimal" IsChecked="{Binding Outcomes.IsMinimal}"
                      Command="{Binding Outcomes.SelectCommand}" CommandParameter="minimal"
                      AutomationProperties.Name="Minimal Station outcome" />
        <ToggleButton Classes="chip" Content="Power" IsChecked="{Binding Outcomes.IsPower}"
                      Command="{Binding Outcomes.SelectCommand}" CommandParameter="power"
                      AutomationProperties.Name="Power Station outcome" />
      </StackPanel>
    </StackPanel>

    <Button Classes="link"
            Content="Use WinMint defaults → Review"
            Command="{Binding UseDefaultsCommand}" />

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="Editors" />
      <ItemsControl ItemsSource="{Binding Chips.Editors}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="Browsers" />
      <ItemsControl ItemsSource="{Binding Chips.Browsers}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="panel-label" Text="Desktop" />
      <Border Classes="panel-card">
        <StackPanel Spacing="6">
          <TextBlock FontWeight="SemiBold" Text="Included by WinMint" />
          <TextBlock Text="Nilesoft Shell — Windows-cohesive shell chrome"
                     AutomationProperties.Name="Included by WinMint: Nilesoft Shell, Windows-cohesive shell chrome"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Classes="panel-label" Text="Taskbar surface" />
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="desktop-card"
                     GroupName="TaskbarSurface"
                     IsChecked="{Binding Desktop.IsWindowsTaskbar}"
                     Command="{Binding Desktop.SelectTaskbarCommand}"
                     CommandParameter="windows"
                     AutomationProperties.Name="Windows taskbar, default">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Windows taskbar" />
            <TextBlock Text="Default Windows surface" />
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="desktop-card"
                     GroupName="TaskbarSurface"
                     IsChecked="{Binding Desktop.IsYasbTaskbar}"
                     Command="{Binding Desktop.SelectTaskbarCommand}"
                     CommandParameter="yasb"
                     AutomationProperties.Name="YASB + tHide"
                     AutomationProperties.HelpText="YASB plus tHide provides the selected taskbar surface. tHide is installed and verified by the desktop provisioning job.">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="YASB + tHide" />
            <TextBlock Text="YASB with tHide taskbar surface" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
      <ToggleButton Classes="desktop-card"
                    IsChecked="{Binding Desktop.Komorebi}"
                    AutomationProperties.Name="Komorebi window management"
                    AutomationProperties.HelpText="Optional window management. Personal use only unless you have a workplace or commercial license.">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Komorebi window management" />
          <TextBlock Text="Independent optional window management" TextWrapping="Wrap" />
          <TextBlock Text="Personal use only unless you have a workplace/commercial license."
                     TextWrapping="Wrap" />
        </StackPanel>
      </ToggleButton>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="panel-label" Text="WSL" />
      <ItemsControl ItemsSource="{Binding Chips.Wsl}" ItemTemplate="{StaticResource ChipTile}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>

    <Expander Header="Advanced packages (optional)" IsExpanded="False">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Classes="hero-sub"
                   Text="Extra install ids merge with chips. MinGit and Nilesoft Shell are always installed." />
        <TextBlock Classes="panel-label" Text="Winget install IDs" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                 Watermark="Anysphere.Cursor&#x0A;Zen-Team.Zen-Browser"
                 Text="{Binding Advanced.Winget}" />
        <TextBlock Classes="panel-label" Text="Scoop IDs" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                 Watermark="curl&#x0A;neovim"
                 Text="{Binding Advanced.Scoop}" />
        <TextBlock Classes="panel-label" Text="WSL tokens" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                 Watermark="FedoraLinux&#x0A;archlinuxarm-wsl&#x0A;NixOS-WSL"
                 Text="{Binding Advanced.Wsl}" />
      </StackPanel>
    </Expander>

    <TextBlock Text="{Binding Status.Message}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemErrorTextColor}"
               IsVisible="{Binding Status.IsError}" />
  </StackPanel>
</UserControl>
