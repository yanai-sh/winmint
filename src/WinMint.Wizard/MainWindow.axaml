<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinMint.Wizard.ViewModels"
        xmlns:views="using:WinMint.Wizard.Views"
        x:Class="WinMint.Wizard.MainWindow"
        x:DataType="vm:WizardShellViewModel"
        Title="WinMint"
        Width="1280"
        Height="860"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        TransparencyBackgroundFallback="{DynamicResource SystemRegionBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Drag region under system caption -->
    <Border Grid.Row="0"
            Height="40"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="TitleBar">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Source="avares://WinMint.Wizard/Assets/mark_ui_132.png"
                 Width="20" Height="20" />
          <TextBlock Text="WinMint"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Opacity="0.9"
                     VerticalAlignment="Center" />
        </StackPanel>
    </Border>

    <ProgressBar Grid.Row="1"
                 Minimum="0"
                 Maximum="1"
                 Value="{Binding ProgressFraction}"
                 Height="3"
                 ShowProgressText="False" />

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="56,28,56,24">
        <views:MediaStepView IsVisible="{Binding IsMediaStep}" />
        <views:YouStepView IsVisible="{Binding IsYouStep}" />
        <views:TasteStepView IsVisible="{Binding IsTasteStep}" />
        <views:IncludedStepView IsVisible="{Binding IsIncludedStep}" />
      </Panel>
    </ScrollViewer>

    <Border Grid.Row="3"
            Padding="28,0"
            Height="72"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <!-- Stage scrub — click Media/You/Taste/Included to jump directly (moodboard intent, no pixel morph). -->
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="stage-scrub" Classes.active="{Binding IsMediaStep}"
                  Content="MEDIA" Command="{Binding GoToMediaCommand}" IsEnabled="{Binding CanGoToMedia}" />
          <Button Classes="stage-scrub" Classes.active="{Binding IsYouStep}"
                  Content="YOU" Command="{Binding GoToYouCommand}" IsEnabled="{Binding CanGoToYou}" />
          <Button Classes="stage-scrub" Classes.active="{Binding IsTasteStep}"
                  Content="TASTE" Command="{Binding GoToTasteCommand}" IsEnabled="{Binding CanGoToTaste}" />
          <Button Classes="stage-scrub" Classes.active="{Binding IsIncludedStep}"
                  Content="INCLUDED" Command="{Binding GoToIncludedCommand}" IsEnabled="{Binding CanGoToIncluded}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <!-- Build/Cancel live here (status bar) so they're reachable from any stage, not just Included (US#11/#28). -->
          <Button Classes="ghost"
                  Content="Cancel"
                  Command="{Binding CancelBuildCommand}"
                  IsVisible="{Binding IsBusy}" />
          <Button Classes="primary"
                  Content="Build"
                  Command="{Binding BuildCommand}"
                  IsEnabled="{Binding CanBuild}"
                  ToolTip.Tip="Requires a saved Profile and an existing Source ISO. Elevates via UAC." />
          <Button Classes="ghost"
                  Content="Back"
                  Command="{Binding BackCommand}"
                  IsEnabled="{Binding CanGoBack}" />
          <Button Classes="primary"
                  Content="{Binding NextLabel}"
                  Command="{Binding NextCommand}"
                  IsEnabled="{Binding CanGoNext}"
                  IsVisible="{Binding !IsIncludedStep}" />
          <Button Classes="primary"
                  Content="Finish"
                  Command="{Binding CloseCommand}"
                  IsVisible="{Binding IsIncludedStep}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
