<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WinMint.Wizard.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <!-- Stock Fluent — follow Windows light/dark; OS accent. -->
    <FluentTheme />

    <Style Selector="ToggleButton.chip">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.chip:checked">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBlock.hero-title">
      <Setter Property="FontSize" Value="40" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hero-sub">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Opacity" Value="0.72" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="520" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.panel-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.iso-stage">
      <Setter Property="Padding" Value="36,40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="Border.panel-card">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
  </Application.Styles>
</Application>
